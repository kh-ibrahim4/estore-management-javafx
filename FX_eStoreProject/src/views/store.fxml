<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="app.StoreController"
            stylesheets="@../styles/style.css">

    <!-- الهيدر -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header-bar">
            <Label text="eStore Dashboard" styleClass="header-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" styleClass="btn-purple"/>
        </HBox>
    </top>

    <!-- المحتوى -->
    <center>
        <VBox spacing="14" styleClass="content-box">

            <!-- الفورم -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="100"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="240"/>
                    <ColumnConstraints minWidth="130"/>
                </columnConstraints>

                <Label text="Code:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="codeField" promptText="Product Code" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" promptText="Product Name" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Price:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="priceField" promptText="0.00" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Quantity:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="quantityField" promptText="0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Currency:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="currencyBox" promptText="Select currency" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Date:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <DatePicker fx:id="datePicker" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Image URL:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <TextField fx:id="urlField" promptText="Optional URL..." GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <!-- معاينة صورة -->
                <ImageView fx:id="productImage"
                           fitHeight="110" fitWidth="110" preserveRatio="true"
                           GridPane.rowIndex="0" GridPane.columnIndex="2" GridPane.rowSpan="4"/>
            </GridPane>

            <!-- أزرار -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="addButton" text="Add" onAction="#handleAdd" styleClass="btn-blue"/>
                <Button fx:id="updateButton" text="Update" onAction="#handleUpdate" styleClass="btn-darkblue"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="btn-red"/>
            </HBox>

            <!-- جدول -->
            <TableView fx:id="productTable" prefHeight="320">
                <columns>
                    <TableColumn fx:id="codeCol" text="Code" prefWidth="100"/>
                    <TableColumn fx:id="nameCol" text="Name" prefWidth="160"/>
                    <TableColumn fx:id="priceCol" text="Price" prefWidth="100"/>
                    <TableColumn fx:id="quantityCol" text="Quantity" prefWidth="100"/>
                    <TableColumn fx:id="currencyCol" text="Currency" prefWidth="100"/>
                    <TableColumn fx:id="dateCol" text="Date" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
