<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="app.LoginController"
            prefWidth="400" prefHeight="250"
            style="-fx-background-color: linear-gradient(to bottom, #e1f5fe, #b3e5fc); -fx-padding: 20;">
    
    <children>
        <VBox alignment="CENTER" spacing="15" layoutX="50" layoutY="20">
            <Label text="Welcome to eStore"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0277bd;"/>
            
            <GridPane hgap="10" vgap="10">
                <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="usernameField" promptText="Enter username"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                
                <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="passwordField" promptText="Enter password"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>
            
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="loginButton" text="Login" onAction="#handleLogin"
                        style="-fx-background-color: #0288d1; -fx-text-fill: white;"/>
                <Button fx:id="signupButton" text="Sign Up" onAction="#handleSignUp"
                        style="-fx-background-color: #0277bd; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
